                day4_low = str(round(data["daily"][3]["temp_low"]))
                day4_datetime = data["daily"][3]["datetime"]
                # Convert timestamp to datetime object (UTC)
                dt_object = datetime.fromtimestamp(day4_datetime, timezone.utc)
                # Format the date
                day4_day = dt_object.strftime("%A")

                return {
                    'moon_phase_num': moon_phase_num,
                    'sunrise': sunrise,
