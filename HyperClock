                    'day4_high': day4_high,
                    'day4_low': day4_low,
                    'last_date': last_date,
                    'last_time': last_time
                    }

    except FileNotFoundError:
        print(f"Error: The file {weather_data_filename} was not found")
        sys.exit(1)
    except PermissionError:
        print(f"Error: Permission denied to read: {weather_data_filename}")
