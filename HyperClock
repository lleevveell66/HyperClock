                    'day2_code': day2_code,
                    'day2_day': day2_day,
                    'day2_high': day2_high,
                    'day2_low': day2_low,
                    'day3_code': day3_code,
                    'day3_day': day3_day,
                    'day3_high': day3_high,
                    'day3_low': day3_low,
                    'day4_code': day4_code,
