def debug_print(string_to_print):
    """
    This function will print the supplied string_to_print, if DEBUG == 1
    """

    if DEBUG == 1:
        print(string_to_print)

def build_rgba(color_list):
    """
    This function takes {color_list} in the format of (R,G,B) and returns a pygame.Color
    """

    red, green, blue = color_list.split(',')
    red=int(red)
    green=int(green)
    blue=int(blue)
    return pygame.Color(red, green, blue)

def av_init():
    """
    This function will initialize the audio and video with pygame.  It will
    determine the screen resolution and return the minimum, maximum, and mid 
    values for X and Y, as well as the screen object.
    """

    pygame.init()
    pygame.font.init()
    pygame.mixer.init(frequency=44100, size=-16, channels=2, buffer=8192)
    pygame.mouse.set_visible(False)

    my_screen=pygame.display.set_mode((0,0),pygame.FULLSCREEN|pygame.NOFRAME)
    my_display_info=pygame.display.Info()
    print(f"Current Resolution: %s x %s\n" % (my_display_info.current_w,my_display_info.current_h))
    syslog.syslog(syslog.LOG_INFO,f"Current Resolution: %s x %s\n" % (my_display_info.current_w,my_display_info.current_h))
    min_x=0
    max_x=my_display_info.current_w
    mid_x=int(max_x/2)
    min_y=0
    max_y=my_display_info.current_h
    mid_y=int(max_y/2)

    return my_screen, min_x, max_x, min_y, max_y, mid_x, mid_y

def get_current_data():
