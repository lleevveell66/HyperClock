def get_astral_data():
    """
    This function will retreive the astral data
    """

    result=re.match("standalone",hyper_config.cfg_topology,flags=re.I)
    if result is None:
        astral_data_cmd=hyper_config.cfg_astral_data_command
        debug_print(f"Running astral_data_cmd {astral_data_cmd}")
        call(astral_data_cmd,shell=True)
    else:
        debug_print(f"Calling get_astral_data.download_and_write_weather")
        get_astral_data.download_and_write_weather(hyper_config.cfg_woeid)

