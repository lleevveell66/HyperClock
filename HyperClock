    the current indoor temp from the {current_indoor_temp} file
    """

    weather_data_filename=hyper_config.cfg_astral_data_file
    indoor_temp_filename=hyper_config.cfg_indoor_temp_file
    
    unicode_arrows={
        'W': '\u2190',
        'N': '\u2191',
        'E': '\u2192',
        'S': '\u2193',
        'NW': '\u2196',
        'NE': '\u2197',
        'SE': '\u2198',
        'SW': '\u2199',
        'NONE': '\u2022'
    }

    try:
        with open(indoor_temp_filename,'r',encoding="utf-8") as file_handle:
            indoor_temp=file_handle.read()
            indoor_temp=indoor_temp[:-1]
            file_handle.close()

    except FileNotFoundError:
        print(f"Error: The file {indoor_temp_filename} was not found")
        sys.exit(1)
    except PermissionError:
        print(f"Error: Permission denied to read: {indoor_temp_filename}")
        sys.exit(1)
    except UnicodeDecodeError:
        print(f"Error: Could not decode file: {indoor_temp_filename} .  Check encoding.")
        sys.exit(1)
    except IOError as other_error:    # Catch other IO errors
        print(f"IOError: {other_error}")
        sys.exit(1)

    try:
        with open(weather_data_filename,'r',encoding="utf-8") as weather_data_file:
            data = json.load(weather_data_file)
        if data:
            if "current" in data:
                current_datetime = int(data["current"]["datetime"])
                # Convert timestamp to datetime object
                dt_object = datetime.fromtimestamp(current_datetime)
                # Format the date
                last_date = dt_object.strftime("%A %m/%d/%Y")
                # Format the time
                last_time = dt_object.strftime("%I:%M %p")

                sunrise_datetime = int(data["current"]["sunrise"])
                # Convert timestamp to datetime object (UTC)
                dt_object = datetime.fromtimestamp(sunrise_datetime)
                # Format the time
                sunrise = dt_object.strftime("%I:%M %p")

                sunset_datetime = int(data["current"]["sunset"])
                # Convert timestamp to datetime object (UTC)
                dt_object = datetime.fromtimestamp(sunset_datetime, timezone.utc)
                # Format the time
                sunset = dt_object.strftime("%I:%M %p")

                pressure = str(round(data["current"]["pressure"]))
                humidity = str(round(data["current"]["humidity"]))

                current_temp = str(round(data["current"]["temp"]))
                temp_high = str(round(data["current"]["temp_high"]))
                temp_low = str(round(data["current"]["temp_low"]))
                current_condition = data["current"]["condition"]
                current_icon = data["current"]["icon"]

                wind_speed = str(round(data["current"]["wind_speed"]))
                wind_dir = int(data["current"]["wind_dir"])
                
                if wind_dir > 338:                            # (339 - 360) North
                    wind_direction=unicode_arrows['N']
                elif wind_dir > 292:                          # (293 - 338) Nortwest
                    wind_direction=unicode_arrows['NW']
                elif wind_dir > 248:                          # (249 - 337) West
                    wind_direction=unicode_arrows['W']
                elif wind_dir > 202:                          # (203 - 248) Southwest
                    wind_direction=unicode_arrows['SW']
                elif wind_dir > 158:                          # (159 - 202) South
                    wind_direction=unicode_arrows['S']
                elif wind_dir > 112:                          # (113 - 158) Southeast
                    wind_direction=unicode_arrows['SE']
                elif wind_dir > 67:                           # ( 68 - 112) East
                    wind_direction=unicode_arrows['E']
                elif wind_dir > 22:                           # ( 23 -  67) Northeast 
                    wind_direction=unicode_arrows['NE']
                elif wind_dir > 22:                           # (  0 -  22) North 
                    wind_direction=unicode_arrows['N']

                moon_phase_percent = float(data["current"]["moon_phase"])
                if moon_phase_percent >= 0.89:                # (0.89 - 1.00) New Moon
                    moon_phase_num=0
                elif moon_phase_percent >= 0.76:              # (0.76 - 0.88) Waning Crescent
                    moon_phase_num=7
                elif moon_phase_percent >= 0.63:              # (0.63 - 0.75) Last Quarter
                    moon_phase_num=6
                elif moon_phase_percent >= 0.51:              # (0.51 - 0.62) Waning Gibbous
                    moon_phase_num=5 
                elif moon_phase_percent >= 0.39:              # (0.39 - 0.50) Full Moon
                    moon_phase_num=4
                elif moon_phase_percent >= 0.26:              # (0.26 - 0.38) Waxing gibbous
                    moon_phase_num=3
                elif moon_phase_percent >= 0.13:              # (0.13 - 0.25) First Quarter
                    moon_phase_num=2
                elif moon_phase_percent >= 0.00:              # (0.00 - 0.12) Waxing Crescent
                    moon_phase_num=1

                #rising="?"
                #rising_num=int(current.getAttribute("rising"))
                #if rising_num==0:
                #    rising=unicode_arrows['NONE']
                #if rising_num==1:
                #    rising=unicode_arrows['N']
